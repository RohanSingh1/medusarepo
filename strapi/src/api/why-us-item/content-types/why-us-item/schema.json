{
  "kind": "collectionType",
  "collectionName": "why_us_items",
  "info": {
    "singularName": "why-us-item",
    "pluralName": "why-us-items",
    "displayName": "Why Us Item",
    "description": "A value-proposition tile in the homepage \"Why Choose Us\" section"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "icon": {
      "type": "enumeration",
      "enum": [
        "HandCoins",
        "Boxes",
        "Truck",
        "ShieldCheck",
        "Star",
        "Award",
        "Clock",
        "Headset",
        "Leaf",
        "MapPin"
      ],
      "default": "ShieldCheck",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
