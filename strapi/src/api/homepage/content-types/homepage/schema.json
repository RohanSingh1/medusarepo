{
  "kind": "singleType",
  "collectionName": "homepages",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "Homepage",
    "description": "Editable copy for the homepage sections (hero, story, collection intro, CTA banner)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "heroEyebrow": { "type": "string" },
    "heroHeadlineLine1": { "type": "string", "required": true },
    "heroHeadlineLine2": { "type": "string" },
    "heroSubcopy": { "type": "text" },
    "heroPrimaryCtaLabel": { "type": "string" },
    "heroPrimaryCtaHref": { "type": "string" },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "storyEyebrow": { "type": "string" },
    "storyHeadline": { "type": "text", "required": true },
    "storyBody1": { "type": "text" },
    "storyBody2": { "type": "text" },
    "storyTags": { "type": "json" },
    "storyImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "collectionEyebrow": { "type": "string" },
    "collectionHeadline": { "type": "string" },
    "collectionIntro": { "type": "text" },
    "collectionFinderHeading": { "type": "string" },
    "collectionFinderQuestions": { "type": "json" },
    "collectionFinderCtaLabel": { "type": "string" },
    "ctaBannerHeadline": { "type": "text" },
    "ctaBannerBody": { "type": "text" },
    "ctaBannerButtonLabel": { "type": "string" },
    "ctaBannerButtonHref": { "type": "string" }
  }
}
